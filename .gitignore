# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local configuration and credentials — never commit these to a public repo.
# dart_defines/ holds official build origins: not secrets, but the public
# repository must carry no default RepSet production origin.
dart_defines/
.env
ios/Flutter/OfficialAds.xcconfig
.env.*
!.env.example
.dev.vars
.wrangler/
.asc/
.agents/
.claude/
*.pem
*.p12
*.key
*.keystore
*.jks
service-account*.json
firebase-adminsdk-*.json
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/Runner/Runner.entitlements

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/.kotlin/
.vscode/

# App Store deliverables and design iterations live with private operations.
# Public README screenshots that have passed the media review live under docs/.
/screenshots/
assets/images/[1-5].png
